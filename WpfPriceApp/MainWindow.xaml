<Window x:Class="WpfPriceApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfPriceApp.ViewModel"
        Title="Request for a price reduction ,additional payment" Height="1000" Width="1880"
        MinHeight="700" MinWidth="1280"
        WindowStartupLocation="CenterScreen" WindowState="Normal">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= 왼쪽: 행사 목록 ================= -->
        <Border Grid.Column="0" Background="{StaticResource Brush.PanelBackground}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="행사 목록" FontWeight="SemiBold" FontSize="14"/>

                <!-- 조회 날짜 필터: 범위로 지정. 기본은 오늘 하루이고, 이 범위와 겹치는 행사만 보여준다 -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="조회 날짜(범위)" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker Grid.Column="0" SelectedDate="{Binding FilterStartDate}"/>
                            <TextBlock Grid.Column="2" Text="~" VerticalAlignment="Center"/>
                            <DatePicker Grid.Column="4" SelectedDate="{Binding FilterEndDate}"/>
                        </Grid>
                        <Button Grid.Row="2" Content="전체보기" Command="{Binding ShowAllEventsCommand}"/>
                    </Grid>
                </StackPanel>

                <ListBox Grid.Row="4" ItemsSource="{Binding EventFiles}" SelectedItem="{Binding SelectedEventFile}"
                         BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding PeriodText}" FontSize="11"
                                           Foreground="{StaticResource Brush.TextSecondary}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <EventSetter Event="MouseDoubleClick" Handler="EventFile_DoubleClick"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <StackPanel Grid.Row="6">
                    <Button Content="새 행사 만들기" Style="{StaticResource PrimaryButton}" Margin="0,0,0,6"
                            Command="{Binding NewEventCommand}"/>
                    <Button Content="목록 새로고침" Margin="0,0,0,6" Command="{Binding RefreshListCommand}"/>
                    <Button Content="저장 폴더 열기" Margin="0,0,0,6" Command="{Binding OpenEventsFolderCommand}"/>
                    <Button Content="선택 행사 삭제 (비밀번호 필요)" Style="{StaticResource DangerButton}"
                            Command="{Binding DeleteEventFileCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 오른쪽: 본문 ================= -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="1.1*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 행사 정보: 행사명 / 기간(시작~종료를 한데 묶음) / 메모를 입력하고, 바로 아래에서 저장까지 한 카드 안에서 처리 -->
            <Border Grid.Row="0" Background="{StaticResource Brush.PanelBackground}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 행사명 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="행사명" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource Brush.TextSecondary}"/>
                        <TextBox Grid.Column="1" Text="{Binding EventName, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14" Padding="6,4"/>
                    </Grid>

                    <!-- 행사 기간(시작~종료를 하나로 묶어서 배치) + 메모 -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="행사 기간" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource Brush.TextSecondary}"/>
                        <Border Grid.Column="1" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                CornerRadius="4" Padding="4">
                            <StackPanel Orientation="Horizontal">
                                <DatePicker Width="130" SelectedDate="{Binding StartDate}" BorderThickness="0"/>
                                <TextBlock Text="~" VerticalAlignment="Center" Margin="4,0"/>
                                <DatePicker Width="130" SelectedDate="{Binding EndDate}" BorderThickness="0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="3" Text="메모" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource Brush.TextSecondary}"/>
                        <TextBox Grid.Column="5" Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                    </Grid>

                    <!-- 저장 관련 동작: 행사 정보를 다 입력한 바로 다음 단계로 이 자리에 모아둔다 -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="저장" Style="{StaticResource PrimaryButton}" Command="{Binding SaveEventCommand}" Margin="0,0,6,0"/>
                        <Button Content="다른 이름으로 저장" Command="{Binding SaveAsCommand}" Margin="0,0,6,0"/>
                        <Button Content="JSON 다운로드(공유용)" Command="{Binding DownloadEventCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 툴바 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <Button Content="상품 추가" Command="{Binding AddProductCommand}" Margin="0,0,6,0"/>
                <Button Content="선택 상품 삭제" Command="{Binding DeleteProductCommand}" Margin="0,0,6,0"/>
                <Button Content="CSV로 내보내기" Command="{Binding ExportCsvCommand}" Margin="0,0,6,0"/>
                <Button Content="품목 마스터 관리" Command="{Binding ManageMasterDataCommand}"/>
            </StackPanel>

            <!-- 상품 목록 그리드. 컬럼 순서는 실제로 쓰는 최신 엑셀과 동일 (GridColumns.cs 참고).
                 컬럼 폭은 내용/헤더 글자수에 맞춰 자동으로 넓어지되, 컬럼이 22개나 되기 때문에
                 가로 스크롤을 최대한 없애려고 폰트·여백을 좁게 잡았다.
                 그리드 자체는 읽기 전용(직접 타이핑 편집 X, 값 변경은 아래 상세 편집 패널에서)이지만,
                 셀 범위를 마우스로 선택해 Ctrl+C 복사 / Ctrl+V 붙여넣기는 됨(행/열/범위 상관없이 전부 가능
                 — 세로로 한 열만 선택해서 복사하는 것도 SelectionUnit=CellOrRowHeader 덕분에 가능).
                 SelectedItem 은 뷰모델에 바인딩하지 않는다 — Cell 계열 SelectionUnit 에서 SelectedItem 을
                 코드로 바꾸면(행사 로드 시 첫 상품 자동 선택 등) 예외가 나는 WPF 제약이 있어서, 대신
                 CurrentCellChanged 로 "지금 클릭한 셀이 속한 행"을 값 편집 패널에 띄운다(코드비하인드). -->
            <DataGrid x:Name="ProductsGrid" Grid.Row="4" ItemsSource="{Binding Rows}"
                      HorizontalScrollBarVisibility="Auto" FontSize="12" RowHeight="30" ColumnHeaderHeight="36"
                      IsReadOnly="True" SelectionUnit="CellOrRowHeader" SelectionMode="Extended"
                      GridLinesVisibility="All" VerticalGridLinesBrush="{StaticResource Brush.Border}"
                      ClipboardCopyMode="ExcludeHeader" PreviewKeyDown="ProductsGrid_PreviewKeyDown"
                      CurrentCellChanged="ProductsGrid_CurrentCellChanged">
                <!-- 컬럼 너비는 내용 기준 Auto 가 아니라 고정값을 쓴다 — 상품명/비고처럼 긴 텍스트가
                     들어오는 열이 Auto 면 그리드 전체가 창 너비를 넘어가서 가로 스크롤이 다시 생긴다.
                     대신 TextTrimmingCell 로 넘치는 글자는 말줄임표(...) 처리한다. -->
                <DataGrid.Resources>
                    <Style x:Key="NumericCell" TargetType="TextBlock">
                        <Setter Property="TextAlignment" Value="Right"/>
                        <Setter Property="Margin" Value="0,0,4,0"/>
                    </Style>
                    <Style x:Key="TextTrimmingCell" TargetType="TextBlock">
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="65" ElementStyle="{StaticResource TextTrimmingCell}"/>
                    <DataGridTextColumn Header="상품명" Binding="{Binding Name}" Width="100" ElementStyle="{StaticResource TextTrimmingCell}"/>
                    <DataGridTextColumn Header="채널" Binding="{Binding Channel}" Width="55" ElementStyle="{StaticResource TextTrimmingCell}"/>
                    <DataGridTextColumn Header="행사유형" Binding="{Binding EventType}" Width="60" ElementStyle="{StaticResource TextTrimmingCell}"/>
                    <DataGridTextColumn Header="판매가" Binding="{Binding SalePrice, StringFormat={}{0:N0}}" Width="62" ElementStyle="{StaticResource NumericCell}"/>
                    <DataGridTextColumn Header="채널&gt;공급가" Binding="{Binding SupplyPrice, StringFormat={}{0:N0}}" Width="72" ElementStyle="{StaticResource NumericCell}"/>
                    <DataGridTextColumn Header="배송비" Binding="{Binding ShippingCost, StringFormat={}{0:N0}}" Width="55" ElementStyle="{StaticResource NumericCell}"/>
                    <DataGridTextColumn Header="수수료" Binding="{Binding FeeRate, StringFormat={}{0:P1}}" Width="55" ElementStyle="{StaticResource NumericCell}"/>
                    <DataGridTextColumn Header="기존정산액(+)" Binding="{Binding ExistingSettlement, StringFormat={}{0:N0}}" Width="80" ElementStyle="{StaticResource NumericCell}"/>
                    <DataGridTextColumn Header="매입가(+)" Binding="{Binding PurchasePrice, StringFormat={}{0:N0}}" Width="68" ElementStyle="{StaticResource NumericCell}"/>
                    <DataGridTextColumn Header="정산액포함매입가(+)" Binding="{Binding SettledPurchasePrice, StringFormat={}{0:N0}}" Width="95" ElementStyle="{StaticResource NumericCell}"/>
                    <DataGridTextColumn Header="캡슐금액" Binding="{Binding CapsuleAmount, StringFormat={}{0:N0}}" Width="60" ElementStyle="{StaticResource NumericCell}"/>
                    <DataGridTextColumn Header="쿠폰액 분담 쿠폰" Binding="{Binding CouponAmount, StringFormat={}{0:N0}}" Width="80" ElementStyle="{StaticResource NumericCell}"/>
                    <DataGridTextColumn Header="마진액" Binding="{Binding MarginAmount, StringFormat={}{0:N0}}" Width="60" ElementStyle="{StaticResource NumericCell}"/>
                    <DataGridTextColumn Header="추가요청금액(+)" Binding="{Binding RequestPlus, StringFormat={}{0:N0}}" Width="78" ElementStyle="{StaticResource NumericCell}"/>
                    <DataGridTextColumn Header="추가요청금액(-)" Binding="{Binding RequestMinus, StringFormat={}{0:N0}}" Width="78" ElementStyle="{StaticResource NumericCell}"/>
                    <DataGridTextColumn Header="최종마진액" Binding="{Binding FinalMargin, StringFormat={}{0:N0}}" Width="68" ElementStyle="{StaticResource NumericCell}"/>
                    <DataGridTextColumn Header="최종마진율" Binding="{Binding FinalMarginRate, StringFormat={}{0:P1}}" Width="62" ElementStyle="{StaticResource NumericCell}"/>
                    <DataGridTextColumn Header="본사(확인용)vat+" Binding="{Binding HqCheckVatPlus, StringFormat={}{0:N0}}" Width="82" ElementStyle="{StaticResource NumericCell}"/>
                    <DataGridTextColumn Header="본사(확인용)vat-" Binding="{Binding HqCheckVatMinus, StringFormat={}{0:N0}}" Width="82" ElementStyle="{StaticResource NumericCell}"/>
                    <DataGridTextColumn Header="기지원금" Binding="{Binding SupportAmount, StringFormat={}{0:N0}}" Width="62" ElementStyle="{StaticResource NumericCell}"/>
                    <DataGridTextColumn Header="비고" Binding="{Binding Note}" Width="*" MinWidth="60" ElementStyle="{StaticResource TextTrimmingCell}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 상세 편집 / 역산 패널 -->
            <Border Grid.Row="6" Background="{StaticResource Brush.PanelBackground}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock Text="선택한 상품 값 편집 — 파란 배경 카드(🔒 체크)만 직접 입력하고, 나머지는 자동으로 역산됩니다."
                                   FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LockStatusText}" DockPanel.Dock="Right"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.Accent}" FontWeight="SemiBold"/>
                    </DockPanel>

                    <ItemsControl Grid.Row="2" ItemsSource="{Binding FieldEditors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 고정(입력) 카드는 파란 톤으로, 자동 계산 카드는 흰색으로 구분해서 한눈에 알아보기 쉽게 함 -->
                                <Border Width="200" Margin="0,0,10,10" Padding="12,10" CornerRadius="8" BorderThickness="1.5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                    <Setter Property="Background" Value="#FFEFF6FF"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" Margin="6,0,0,0" IsChecked="{Binding IsLocked}"
                                                      ToolTip="체크하면 이 값을 직접 입력합니다(고정). 해제하면 자동으로 계산됩니다."/>
                                            <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,4"
                                                 IsEnabled="{Binding IsLocked}" FontSize="16" TextAlignment="Right" Padding="6,6"/>
                                        <TextBlock HorizontalAlignment="Right" FontSize="10">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="자동 계산됨"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                            <Setter Property="Text" Value="✓ 직접 입력(고정)"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- 상태바 + 계산 버튼 -->
            <DockPanel Grid.Row="8">
                <Button DockPanel.Dock="Right" Content="역산/계산 실행" Style="{StaticResource PrimaryButton}"
                        Padding="18,8" Command="{Binding RecalculateCommand}"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{StaticResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
