<Window x:Class="WpfPriceApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfPriceApp.ViewModel"
        Title="Request for a price reduction ,additional payment" Height="1102" Width="1720"
        MinHeight="700" MinWidth="1280"
        WindowStartupLocation="CenterScreen" WindowState="Normal">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= 왼쪽: 행사 목록 ================= -->
        <Border Grid.Column="0" Background="{StaticResource Brush.PanelBackground}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="행사 목록" FontWeight="SemiBold" FontSize="14"/>

                <!-- 조회 날짜 필터: 기본은 오늘 날짜이고, 이 날짜가 기간에 포함된 행사만 보여준다 -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="조회 날짜" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <DatePicker Grid.Column="0" SelectedDate="{Binding FilterDate}"/>
                        <Button Grid.Column="2" Content="전체보기" Padding="8,0" Command="{Binding ShowAllEventsCommand}"/>
                    </Grid>
                </StackPanel>

                <ListBox Grid.Row="4" ItemsSource="{Binding EventFiles}" SelectedItem="{Binding SelectedEventFile}"
                         BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding PeriodText}" FontSize="11"
                                           Foreground="{StaticResource Brush.TextSecondary}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <EventSetter Event="MouseDoubleClick" Handler="EventFile_DoubleClick"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <StackPanel Grid.Row="6">
                    <Button Content="새 행사 만들기" Style="{StaticResource PrimaryButton}" Margin="0,0,0,6"
                            Command="{Binding NewEventCommand}"/>
                    <Button Content="목록 새로고침" Margin="0,0,0,6" Command="{Binding RefreshListCommand}"/>
                    <Button Content="저장 폴더 열기" Margin="0,0,0,6" Command="{Binding OpenEventsFolderCommand}"/>
                    <Button Content="선택 행사 삭제 (비밀번호 필요)" Style="{StaticResource DangerButton}"
                            Command="{Binding DeleteEventFileCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 오른쪽: 본문 ================= -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="1.1*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 행사 정보: 행사명 / 기간(시작~종료를 한데 묶음) / 메모를 입력하고, 바로 아래에서 저장까지 한 카드 안에서 처리 -->
            <Border Grid.Row="0" Background="{StaticResource Brush.PanelBackground}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 행사명 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="행사명" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource Brush.TextSecondary}"/>
                        <TextBox Grid.Column="1" Text="{Binding EventName, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14" Padding="6,4"/>
                    </Grid>

                    <!-- 행사 기간(시작~종료를 하나로 묶어서 배치) + 메모 -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="행사 기간" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource Brush.TextSecondary}"/>
                        <Border Grid.Column="1" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                CornerRadius="4" Padding="4">
                            <StackPanel Orientation="Horizontal">
                                <DatePicker Width="130" SelectedDate="{Binding StartDate}" BorderThickness="0"/>
                                <TextBlock Text="~" VerticalAlignment="Center" Margin="4,0"/>
                                <DatePicker Width="130" SelectedDate="{Binding EndDate}" BorderThickness="0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="3" Text="메모" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource Brush.TextSecondary}"/>
                        <TextBox Grid.Column="5" Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                    </Grid>

                    <!-- 저장 관련 동작: 행사 정보를 다 입력한 바로 다음 단계로 이 자리에 모아둔다 -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="저장" Style="{StaticResource PrimaryButton}" Command="{Binding SaveEventCommand}" Margin="0,0,6,0"/>
                        <Button Content="다른 이름으로 저장" Command="{Binding SaveAsCommand}" Margin="0,0,6,0"/>
                        <Button Content="JSON 다운로드(공유용)" Command="{Binding DownloadEventCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 툴바 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <Button Content="상품 추가" Command="{Binding AddProductCommand}" Margin="0,0,6,0"/>
                <Button Content="선택 상품 삭제" Command="{Binding DeleteProductCommand}" Margin="0,0,6,0"/>
                <Button Content="CSV로 내보내기" Command="{Binding ExportCsvCommand}" Margin="0,0,6,0"/>
                <Button Content="채널/품목 관리" Command="{Binding ManageMasterDataCommand}"/>
            </StackPanel>

            <!-- 상품 목록 그리드 (컬럼 폭은 내용에 맞춰 자동으로 넓어져 숫자/글씨가 잘리지 않음) -->
            <DataGrid Grid.Row="4" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                      HorizontalScrollBarVisibility="Auto" FontSize="13">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="상품명" Binding="{Binding Name}" Width="Auto" MinWidth="110"/>
                    <DataGridTextColumn Header="채널" Binding="{Binding Channel}" Width="Auto" MinWidth="80"/>
                    <DataGridTextColumn Header="판매가" Binding="{Binding SalePrice, StringFormat={}{0:N0}}" Width="Auto" MinWidth="80"/>
                    <DataGridTextColumn Header="공급가" Binding="{Binding SupplyPrice, StringFormat={}{0:N0}}" Width="Auto" MinWidth="80"/>
                    <DataGridTextColumn Header="배송비" Binding="{Binding ShippingCost, StringFormat={}{0:N0}}" Width="Auto" MinWidth="75"/>
                    <DataGridTextColumn Header="수수료" Binding="{Binding FeeRate, StringFormat={}{0:P1}}" Width="Auto" MinWidth="75"/>
                    <DataGridTextColumn Header="기존지원금" Binding="{Binding ExistingSubsidy, StringFormat={}{0:N0}}" Width="Auto" MinWidth="95"/>
                    <DataGridTextColumn Header="원가" Binding="{Binding Cost, StringFormat={}{0:N0}}" Width="Auto" MinWidth="80"/>
                    <DataGridTextColumn Header="실원가" Binding="{Binding RealCost, StringFormat={}{0:N0}}" Width="Auto" MinWidth="80"/>
                    <DataGridTextColumn Header="마진액" Binding="{Binding MarginAmount, StringFormat={}{0:N0}}" Width="Auto" MinWidth="80"/>
                    <DataGridTextColumn Header="추가요청(+)" Binding="{Binding RequestPlus, StringFormat={}{0:N0}}" Width="Auto" MinWidth="95"/>
                    <DataGridTextColumn Header="추가요청(-)" Binding="{Binding RequestMinus, StringFormat={}{0:N0}}" Width="Auto" MinWidth="95"/>
                    <DataGridTextColumn Header="최종마진액" Binding="{Binding FinalMargin, StringFormat={}{0:N0}}" Width="Auto" MinWidth="95"/>
                    <DataGridTextColumn Header="최종마진율" Binding="{Binding FinalMarginRate, StringFormat={}{0:P1}}" Width="Auto" MinWidth="90"/>
                    <DataGridTextColumn Header="예상수량" Binding="{Binding ExpectedQty, StringFormat={}{0:N0}}" Width="Auto" MinWidth="80"/>
                    <DataGridTextColumn Header="예상추가비용" Binding="{Binding ExpectedCost, StringFormat={}{0:N0}}" Width="Auto" MinWidth="105"/>
                    <DataGridTextColumn Header="비고" Binding="{Binding Note}" Width="*" MinWidth="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 상세 편집 / 역산 패널 -->
            <Border Grid.Row="6" Background="{StaticResource Brush.PanelBackground}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock Text="선택한 상품 값 편집 — 잠금(🔒) 체크된 값만 직접 입력하고, 나머지는 자동으로 역산됩니다."
                                   FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LockStatusText}" DockPanel.Dock="Right"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.Accent}" FontWeight="SemiBold"/>
                    </DockPanel>

                    <ItemsControl Grid.Row="2" ItemsSource="{Binding FieldEditors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="220" Margin="0,0,10,10" Padding="10" Background="White"
                                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" Margin="6,0,0,0" IsChecked="{Binding IsLocked}"
                                                      ToolTip="체크하면 이 값을 직접 입력합니다(고정)."/>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{StaticResource Brush.TextSecondary}"/>
                                        </DockPanel>
                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,6,0,0" IsEnabled="{Binding IsLocked}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- 상태바 + 계산 버튼 -->
            <DockPanel Grid.Row="8">
                <Button DockPanel.Dock="Right" Content="역산/계산 실행" Style="{StaticResource PrimaryButton}"
                        Padding="18,8" Command="{Binding RecalculateCommand}"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{StaticResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
