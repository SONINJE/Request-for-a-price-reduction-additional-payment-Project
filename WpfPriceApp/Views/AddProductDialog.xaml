<Window x:Class="WpfPriceApp.Views.AddProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="상품 추가" Width="460" Height="740" MinWidth="420" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource Brush.Background}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="상품 추가" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}"/>
            <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextSecondary}"
                       Text="품목 마스터에서 고르면 SKU/채널/매입가(+)/기존정산액(+)이 자동으로 채워집니다. 아래 검색창은 목록을 찾는 용도이고, 목록에 없는 새 품목은 &quot;새 품목 등록&quot; 칸에서 따로 추가합니다."/>
        </StackPanel>

        <!-- 검색 (목록 필터 전용 — 새 품목 등록과 분리) -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="품목 마스터 검색" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" Margin="0,0,0,4"/>
            <TextBox x:Name="SearchBox" Height="32" VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged"
                     ToolTip="아래 목록만 걸러줍니다 — 새 품목을 추가하려면 아래 '새 품목 등록'을 쓰세요."/>
        </StackPanel>

        <!-- 품목 마스터 목록 -->
        <Border Grid.Row="4" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6">
            <ListBox x:Name="ProductList" BorderThickness="0" SelectionChanged="ProductList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6,4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource Brush.TextSecondary}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="SKU {0}  ·  채널 {1}  ·  매입가 {2:N0}">
                                        <Binding Path="Sku"/>
                                        <Binding Path="Channel"/>
                                        <Binding Path="PurchasePrice"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 새 품목 등록 (검색과 확실히 구분되도록 별도 카드 + 강조 테두리) -->
        <Border Grid.Row="6" BorderBrush="{StaticResource Brush.Accent}" BorderThickness="1" CornerRadius="6"
                Background="{StaticResource Brush.PanelBackground}" Padding="10">
            <StackPanel>
                <TextBlock Text="새 품목 등록 — 목록에 없는 상품을 품목 마스터에 새로 추가" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Accent}" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewNameBox" Grid.Column="0" Height="32" VerticalContentAlignment="Center"
                             ToolTip="새로 등록할 상품명을 입력하세요."/>
                    <Button Grid.Column="2" Content="등록" Height="32" Padding="16,0" Click="AddMasterProduct_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 선택한 품목의 SKU/채널 (품목 마스터 값) -->
        <Border Grid.Row="8" x:Name="EditPanel" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                CornerRadius="6" Padding="10" Visibility="Collapsed">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="선택한 품목의 SKU / 채널 (품목 마스터에 바로 저장됩니다)" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="선택 삭제" Height="26" Padding="8,0" FontSize="11" Click="RemoveMasterProduct_Click"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SKU" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}"/>
                        <TextBox x:Name="SkuBox" Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center"
                                 TextChanged="EditField_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="채널" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}"/>
                        <TextBox x:Name="ChannelBox" Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center"
                                 TextChanged="EditField_TextChanged"/>
                    </StackPanel>
                </Grid>
                <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextSecondary}"
                           Text="매입가(+)/기존정산액(+) 등 금액 항목은 &quot;품목 마스터 관리&quot; 창에서 입력·수정합니다."/>
            </StackPanel>
        </Border>

        <!-- 이번에 추가하는 상품(행)의 행사유형/비고 — 품목 마스터가 아니라 이 행사에만 적용됨 -->
        <Border Grid.Row="10" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="10">
            <StackPanel>
                <TextBlock Text="이번에 추가하는 상품의 행사유형 / 비고" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.TextPrimary}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="행사유형" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}"/>
                        <TextBox x:Name="EventTypeBox" Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="비고" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}"/>
                        <TextBox x:Name="NoteBox" Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="12" x:Name="SelectionHint" FontSize="12" Foreground="{StaticResource Brush.Accent}"
                   TextWrapping="Wrap" Text=" "/>

        <StackPanel Grid.Row="14" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Width="84" Height="32" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="상품 추가" Width="96" Height="32" Style="{StaticResource PrimaryButton}"
                    Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
