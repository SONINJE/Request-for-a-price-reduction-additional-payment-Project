<Window x:Class="WpfPriceApp.Views.AddProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="상품 추가" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FFFFFFFF">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="품목(상품명) — 목록에서 고르거나 새로 입력하세요." Margin="0,0,0,6" FontSize="13"
                   TextWrapping="Wrap" Foreground="#FF333333"/>
        <ComboBox x:Name="ItemBox" Grid.Row="1" Height="30" IsEditable="True"
                  BorderBrush="#FFCBD5E1" BorderThickness="1"/>

        <TextBlock Grid.Row="3" Text="채널 — 목록에서 고르거나 새로 입력하세요." Margin="0,0,0,6" FontSize="13"
                   TextWrapping="Wrap" Foreground="#FF333333"/>
        <ComboBox x:Name="ChannelBox" Grid.Row="4" Height="30" IsEditable="True"
                  BorderBrush="#FFCBD5E1" BorderThickness="1"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Width="76" Height="30" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="확인" Width="76" Height="30" Click="Ok_Click" IsDefault="True"
                    Background="#FF2563EB" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
