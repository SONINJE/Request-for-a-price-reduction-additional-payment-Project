<Window x:Class="WpfPriceApp.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="비밀번호 확인" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FFFFFFFF" ShowInTaskbar="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0" Text="비밀번호를 입력하세요." Margin="0,0,0,10" FontSize="13"
                   TextWrapping="Wrap" Foreground="#FF333333"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="1" Height="30" Padding="4" VerticalContentAlignment="Center"
                     BorderBrush="#FFCBD5E1" BorderThickness="1"/>
        <TextBlock x:Name="ErrorText" Grid.Row="2" Text="비밀번호가 올바르지 않습니다." Margin="0,6,0,0"
                   Foreground="#FFDC2626" FontSize="12" Visibility="Collapsed"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Width="76" Height="30" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="확인" Width="76" Height="30" Click="Ok_Click" IsDefault="True"
                    Background="#FF2563EB" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
