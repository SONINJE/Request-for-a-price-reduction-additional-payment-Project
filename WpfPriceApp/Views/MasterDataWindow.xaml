<Window x:Class="WpfPriceApp.Views.MasterDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="채널 / 품목 관리" Height="540" Width="620" MinHeight="420" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFFFF">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 채널 목록 -->
        <Grid Grid.Column="0" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="채널 목록" FontWeight="SemiBold" FontSize="14"/>
            <ListBox x:Name="ChannelList" Grid.Row="2" BorderBrush="#FFCBD5E1" BorderThickness="1"/>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewChannelBox" Grid.Column="0" Height="26" VerticalContentAlignment="Center"
                         BorderBrush="#FFCBD5E1" BorderThickness="1"/>
                <Button Grid.Column="2" Content="추가" Width="50" Height="26" Click="AddChannel_Click"/>
                <Button Grid.Column="4" Content="삭제" Width="50" Height="26" Click="RemoveChannel_Click"/>
            </Grid>
        </Grid>

        <!-- 품목 목록 -->
        <Grid Grid.Column="2" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="품목 목록" FontWeight="SemiBold" FontSize="14"/>
            <ListBox x:Name="ItemList" Grid.Row="2" BorderBrush="#FFCBD5E1" BorderThickness="1"/>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewItemBox" Grid.Column="0" Height="26" VerticalContentAlignment="Center"
                         BorderBrush="#FFCBD5E1" BorderThickness="1"/>
                <Button Grid.Column="2" Content="추가" Width="50" Height="26" Click="AddItem_Click"/>
                <Button Grid.Column="4" Content="삭제" Width="50" Height="26" Click="RemoveItem_Click"/>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="닫기" Width="80" Height="28" Click="Close_Click" IsDefault="True"
                    Background="#FF2563EB" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
