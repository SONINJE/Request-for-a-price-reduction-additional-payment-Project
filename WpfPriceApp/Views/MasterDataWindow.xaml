<Window x:Class="WpfPriceApp.Views.MasterDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="품목 마스터 관리" Height="560" Width="1080" MinHeight="420" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFFFF">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="12" Foreground="#FF666666" TextWrapping="Wrap"
                   Text="상품명으로 상품을 추가하면 여기 있는 SKU/매입가(VAT+)/기존정산액(지원금_S)/채널이 자동으로 채워집니다. 셀을 더블클릭해서 바로 수정할 수 있습니다."/>

        <DataGrid Grid.Row="2" x:Name="ProductGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="상품명" Binding="{Binding Name}" Width="Auto" MinWidth="140"/>
                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="Auto" MinWidth="90"/>
                <DataGridTextColumn Header="매입가(VAT+)" Binding="{Binding PurchasePrice}" Width="Auto" MinWidth="100"/>
                <DataGridTextColumn Header="행사가" Binding="{Binding EventPrice}" Width="Auto" MinWidth="80"/>
                <DataGridTextColumn Header="스팟가" Binding="{Binding SpotPrice}" Width="Auto" MinWidth="80"/>
                <DataGridTextColumn Header="지원금(vat+)_S" Binding="{Binding SubsidySpot}" Width="Auto" MinWidth="110"/>
                <DataGridTextColumn Header="지원금(vat+)_E" Binding="{Binding SubsidyEvent}" Width="Auto" MinWidth="110"/>
                <DataGridTextColumn Header="지원금(vat+)_R" Binding="{Binding SubsidyRegular}" Width="Auto" MinWidth="110"/>
                <DataGridTextColumn Header="채널" Binding="{Binding Channel}" Width="Auto" MinWidth="100"/>
                <DataGridTextColumn Header="비고" Binding="{Binding Note}" Width="*" MinWidth="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="품목 추가" Width="80" Height="28" Margin="0,0,8,0" Click="AddRow_Click"/>
            <Button Content="선택 삭제" Width="80" Height="28" Margin="0,0,20,0" Click="RemoveRow_Click"/>
            <Button Content="닫기" Width="80" Height="28" Click="Close_Click" IsDefault="True"
                    Background="#FF2563EB" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
