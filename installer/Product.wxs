<?xml version="1.0" encoding="utf-8"?>
<!--
  PriceCalcApp 설치 프로그램 (WiX Toolset v5).
  UpgradeCode 는 절대 바꾸지 않는다 — 다음 버전을 낼 때 MSI 업그레이드가 이 값으로 이전 설치를 찾는다.
  파일 목록(Files.wxs)은 installer\build_installer.ps1 이 publish 폴더를 스캔해 자동 생성한다.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="판매가 인하 / 추가금 요청 관리 프로그램"
            Manufacturer="PriceCalcApp"
            Version="2.2.0"
            UpgradeCode="4c3e4b93-c1e6-4575-bcd6-c5fe3606b837"
            Language="1042"
            Codepage="65001"
            Compressed="yes"
            InstallerVersion="500">

    <SummaryInformation Keywords="Installer" Description="판매가 인하 / 추가금 요청 관리 프로그램 설치" Manufacturer="PriceCalcApp" />

    <MajorUpgrade DowngradeErrorMessage="이미 더 최신 버전이 설치되어 있습니다." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="PriceCalcApp" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppProgramMenuFolder" Name="판매가 인하 관리 프로그램">
        <Component Id="ApplicationShortcut" Guid="7a1f3b1a-9d2e-4a6b-8f3d-2b6e5c9a10e1">
          <Shortcut Id="StartMenuShortcut"
                    Name="판매가 인하 관리 프로그램"
                    Description="판매가 인하 / 추가금 요청 관리 프로그램"
                    Target="[INSTALLFOLDER]WpfPriceApp.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <Shortcut Id="UninstallShortcut"
                    Name="판매가 인하 관리 프로그램 제거"
                    Target="[SystemFolder]msiexec.exe"
                    Arguments="/x [ProductCode]"
                    Description="판매가 인하 관리 프로그램을 제거합니다." />
          <RemoveFolder Id="RemoveAppProgramMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\PriceCalcApp" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="c2b6d7e4-5a3f-4e1c-9b7a-1d4f6e8c2a30" Directory="DesktopFolder">
        <Shortcut Id="DesktopAppShortcut"
                  Name="판매가 인하 관리 프로그램"
                  Description="판매가 인하 / 추가금 요청 관리 프로그램"
                  Target="[INSTALLFOLDER]WpfPriceApp.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFile Id="RemoveDesktopShortcut" Name="판매가 인하 관리 프로그램.lnk" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\PriceCalcApp" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="판매가 인하 관리 프로그램" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

  </Package>
</Wix>
